# Copie para .env.docker e substitua todos os valores TROQUE_ANTES_DE_USAR.
# Nunca envie o arquivo .env.docker ao GitHub.

POSTGRES_DB=dominium
POSTGRES_USER=dominium
POSTGRES_PASSWORD=TROQUE_ANTES_DE_USAR_POSTGRES

# Use pelo menos 32 caracteres aleatorios em cada segredo abaixo.
N8N_ENCRYPTION_KEY=TROQUE_ANTES_DE_USAR_N8N
DOMINIUM_INGEST_TOKEN=TROQUE_ANTES_DE_USAR_INGESTAO

# URL exibida em Firebase Console > Realtime Database > Dados.
# Exemplo: https://seu-projeto-default-rtdb.firebaseio.com
FIREBASE_DATABASE_URL=https://SEU_PROJETO-default-rtdb.firebaseio.com

# Ambiente local Docker Desktop.
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_EDITOR_BASE_URL=http://localhost:5678/
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_SECURE_COOKIE=false
N8N_LOCAL_PORT=5678
DOMINIUM_API_PORT=8780
DOMINIUM_WEB_PORT=8088

# Origens autorizadas a consultar a API pelo navegador, separadas por virgula.
CORS_ORIGINS=http://localhost:8088,http://127.0.0.1:8088,http://localhost:5173,http://127.0.0.1:5173

# Somente para publicacao em uma VPS. Os dois DNS precisam apontar para a VPS.
PANEL_DOMAIN=painel.seudominio.com.br
N8N_DOMAIN=n8n.seudominio.com.br
