{
  "rules": {
    ".read": false,
    ".write": false,
    "authorizedUsers": {
      "$uid": {
        ".read": "auth != null && $uid === auth.uid",
        ".write": false
      }
    },
    "dominium": {
      "toa": {
        "current": {
          ".read": true,
          ".write": false
        },
        "history": {
          ".read": true,
          ".write": false
        }
      }
    }
  }
}