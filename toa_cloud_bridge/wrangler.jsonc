{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dominium-toa-bridge",
  "main": "src/index.js",
  "compatibility_date": "2026-08-20",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": [
      "17 * * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dominium-toa-bridge",
      "database_id": "735a5385-2980-4f81-9c37-179e5c540749",
      "migrations_dir": "migrations"
    }
  ]
}

