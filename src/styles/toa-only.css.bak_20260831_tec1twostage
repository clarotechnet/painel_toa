  padding: 11px 13px;
  text-align: left;
  transition: background .14s ease, border-color .14s ease, transform .14s ease;
}
.monitor-tv-drill-row:hover,
.monitor-tv-drill-row:focus-visible {
  background: #171f28;
  border-color: #59697a;
  outline: none;
  transform: translateY(-1px);
}
.monitor-tv-drill-row > span { display: grid; gap: 2px; min-width: 0; }
.monitor-tv-drill-row small { color: #758394; font-size: 8px; font-weight: 800; text-transform: uppercase; }
.monitor-tv-drill-row strong { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.monitor-tv-drill-row-main strong { color: #ff6672; font-size: 13px; }
.monitor-tv-drill-row-main small { color: #b3bec9; font-size: 10px; text-transform: none; }
.monitor-tv-drill-row > svg { color: #768494; height: 16px; width: 16px; }
.monitor-tv-drill-empty { color: #83909e; padding: 50px 20px; text-align: center; }

.monitor-tv-order-detail-grid {
  display: grid;
  gap: 9px;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  overflow: auto;
  padding: 18px 20px;
}
.monitor-tv-order-detail-grid > span {
  background: #10161d;
  border: 1px solid #29343f;
  border-radius: 9px;
  display: grid;
  gap: 5px;
  min-height: 68px;
  padding: 12px;
}
.monitor-tv-order-detail-grid small {
  color: #778596;
  font-size: 8px;
  font-weight: 850;
  text-transform: uppercase;
}
.monitor-tv-order-detail-grid strong {
  color: #eef3f7;
  font-size: 12px;
  overflow-wrap: anywhere;
}
.monitor-tv-drill-panel > footer {
  align-items: center;
  border-top: 1px solid #29333d;
  display: flex;
  gap: 8px;
  justify-content: flex-end;
  padding: 12px 16px;
}
.monitor-tv-drill-panel > footer > span {
  color: #788594;
  font-size: 10px;
  margin-right: auto;
}
.monitor-tv-drill-panel > footer button {
  align-items: center;
  border-radius: 8px;
  cursor: pointer;
  display: inline-flex;
  font-size: 10px;
  font-weight: 850;
  gap: 7px;
  padding: 9px 12px;
}
.monitor-tv-drill-panel > footer button svg { height: 14px; width: 14px; }
.monitor-tv-drill-panel > footer button.secondary {
  background: #151b22;
  border: 1px solid #34404c;
  color: #d9e1e8;
}
.monitor-tv-drill-panel > footer button.primary {
  background: #d91f31;
  border: 1px solid #f04a59;
  color: #fff;
}
html[data-theme="light"] .monitor-tv-drilldown { background: rgba(226, 232, 238, .72); }
html[data-theme="light"] .monitor-tv-drill-panel {
  background: linear-gradient(150deg, #ffffff, #f4f7fa);
  border-color: #cbd6e0;
  box-shadow: 0 24px 70px rgba(31, 45, 61, .2);
  color: #17212b;
}
html[data-theme="light"] .monitor-tv-drill-panel > header,
html[data-theme="light"] .monitor-tv-drill-panel > footer { border-color: #d6e0e8; }
html[data-theme="light"] .monitor-tv-drill-panel > header button,
html[data-theme="light"] .monitor-tv-drill-toolbar label,
html[data-theme="light"] .monitor-tv-drill-row,
html[data-theme="light"] .monitor-tv-order-detail-grid > span {
  background: #f7f9fc;
  border-color: #d5dfe8;
  color: #1f2d3c;
}
html[data-theme="light"] .monitor-tv-drill-toolbar input { color: #17212b; }
html[data-theme="light"] .monitor-tv-drill-row:hover { background: #eef3f7; border-color: #9eacba; }
html[data-theme="light"] .monitor-tv-order-detail-grid strong { color: #253345; }

@media (max-width: 1100px) {
  .monitor-tv-drilldown { padding: 10px; }
  .monitor-tv-drill-panel { width: 98vw; }
  .monitor-tv-drill-row {
    grid-template-columns: minmax(180px, 1.4fr) minmax(90px, .7fr) minmax(140px, 1fr) minmax(90px, .7fr) 18px;
  }
  .monitor-tv-drill-row > span:nth-child(4),
  .monitor-tv-drill-row > span:nth-child(6) { display: none; }
  .monitor-tv-order-detail-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}
@media (max-width: 700px) {
  .monitor-tv-drill-panel > header { padding: 13px; }
  .monitor-tv-drill-toolbar { align-items: stretch; flex-direction: column; padding: 10px 12px; }
  .monitor-tv-drill-toolbar label { max-width: none; }
  .monitor-tv-drill-row { grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr) minmax(80px, .7fr) 16px; }
  .monitor-tv-drill-row > span:nth-child(2),
  .monitor-tv-drill-row > span:nth-child(4),
  .monitor-tv-drill-row > span:nth-child(6) { display: none; }
  .monitor-tv-order-detail-grid { grid-template-columns: 1fr; padding: 12px; }
  .monitor-tv-drill-panel > footer { flex-wrap: wrap; }
  .monitor-tv-drill-panel > footer > span { flex-basis: 100%; }
}
