{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dominium-mobile-bridge",
  "main": "src/index.js",
  "compatibility_date": "2026-08-20",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["17 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dominium-mobile-telemetry",
      "database_id": "e384d14e-8b11-4e8d-a58e-5055d7ab0dda",
      "migrations_dir": "migrations"
    }
  ]
}
